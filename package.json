{
  "name": "traceprojector",
  "version": "0.1.0",
  "description": "Commuting, Discrete-trace Preserving Projections for the 3D de Rham complex on simplicial meshes.",
  "type": "module",
  "sideEffects": false,
  "main": "traceprojector/traceprojector.js",
  "homepage": "https://github.com/sachncs/traceprojector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sachncs/traceprojector.git"
  },
  "bugs": {
    "url": "https://github.com/sachncs/traceprojector/issues"
  },
  "author": "Sachin <sachncs@gmail.com>",
  "license": "MIT",
  "keywords": [
    "finite-element-method",
    "de-rham-complex",
    "whitney-forms",
    "simplicial-mesh",
    "tetrahedral-mesh",
    "projection",
    "hodge-star",
    "discrete-operators",
    "scientific-computing",
    "numerical-analysis"
  ],
  "module": "dist/traceprojector.esm.js",
  "unpkg": "dist/traceprojector.umd.js",
  "jsdelivr": "dist/traceprojector.umd.js",
  "exports": {
    ".": {
      "types": "./traceprojector/traceprojector.d.ts",
      "default": "./traceprojector/traceprojector.js"
    },
    "./mesh": {
      "types": "./traceprojector/mesh.d.ts",
      "default": "./traceprojector/mesh.js"
    },
    "./whitney": {
      "types": "./traceprojector/whitney.d.ts",
      "default": "./traceprojector/whitney.js"
    },
    "./quadrature": {
      "types": "./traceprojector/quadrature.d.ts",
      "default": "./traceprojector/quadrature.js"
    },
    "./utils": {
      "types": "./traceprojector/utils.d.ts",
      "default": "./traceprojector/utils.js"
    },
    "./locator": {
      "types": "./traceprojector/locator.d.ts",
      "default": "./traceprojector/locator.js"
    },
    "./generator": {
      "types": "./traceprojector/generator.d.ts",
      "default": "./traceprojector/generator.js"
    },
    "./parallel": {
      "types": "./traceprojector/parallel.d.ts",
      "default": "./traceprojector/parallel.js"
    }
  },
  "types": "traceprojector/traceprojector.d.ts",
  "files": [
    "traceprojector/",
    "dist/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "site"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "mocha tests/**/*.test.js",
    "validate": "mocha --config validation/.mocharc.yml",
    "test:watch": "mocha tests/**/*.test.js --watch",
    "test:coverage": "c8 --reporter=text --reporter=html --reporter=lcov npm test",
    "docs": "node scripts/gen-api.mjs",
    "docs:check": "node scripts/gen-api.mjs --check",
    "build": "rollup -c rollup.dist.config.js",
    "build:full": "npm run build && npm run docs",
    "site:dev": "npm run -w site dev",
    "site:build": "npm run -w site build",
    "site:start": "npm run -w site start",
    "docs:warn": "node scripts/gen-warnings-doc.mjs",
    "docs:warn:check": "node scripts/gen-warnings-doc.mjs --check",
    "lint:package": "publint && attw --pack . --profile esm-only",
    "test:types": "tsd",
    "verify:types": "node scripts/check-types.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run lint && npm run docs:check && npm run test:coverage && npm run build && node scripts/check-dist-exports.mjs && npm run verify:types && npm run test:types && npm run lint:package && npm run verify:package",
    "verify:site": "node scripts/verify-site.mjs",
    "validate:slow": "mocha --config validation/.mocharc.slow.yml",
    "bench": "node --expose-gc scripts/bench.mjs",
    "bench:check": "node --expose-gc scripts/bench.mjs --check",
    "bench:update": "node --expose-gc scripts/bench.mjs --update"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@stryker-mutator/core": "^10.0.0",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdoc-to-markdown": "^9.1.3",
    "mocha": "^12.0.3",
    "publint": "^0.3.25",
    "robust-predicates": "^3.0.3",
    "rollup": "^4.65.0",
    "sinon": "^22.1.0",
    "tsd": "^0.33.0"
  },
  "tsd": {
    "directory": "tests-d"
  }
}
